FROM quay.io/pypa/manylinux_2_28_aarch64:2025.09.01-1

WORKDIR /root


RUN git clone https://github.com/jedisct1/libsodium.git && \
    cd libsodium && git checkout 1.0.20-RELEASE && \
    ./autogen.sh && \
    ./configure && \
    make -j && \
    make check && \
    make install

RUN git clone https://github.com/zeromq/libzmq.git && \
    cd libzmq && git checkout v4.3.5 && \
    mkdir build && \
    cd build && \
    cmake .. -DCMAKE_POLICY_VERSION_MINIMUM=3.5&& \
    make -j && \
    make install

RUN git clone https://github.com/zeromq/cppzmq.git && \
    cd cppzmq && git checkout v4.10.0 && \
    mkdir build && \
    cd build && \
    cmake .. && \
    make -j && \
    make install

# This version is buggy. Will use the one installed in a python virtual environment.
# RUN git clone https://github.com/pybind/pybind11.git && \
#     cd pybind11 && git checkout v2.13.6 && \
#     mkdir build && \
#     cd build && \
#     cmake .. && \
#     make -j && \
#     make install

RUN git clone https://github.com/gabime/spdlog.git && \
    cd spdlog && git checkout v1.15.1 && \
    mkdir build && \
    cd build && \
    cmake .. && \
    make -j && \
    make install

ARG ROBOTMQ_COMMIT
LABEL org.opencontainers.image.revision=$ROBOTMQ_COMMIT

WORKDIR /root/robot-message-queue
COPY . .
RUN bash wheels/build_in_container.sh
